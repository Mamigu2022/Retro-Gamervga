# sdkconfig.board

# PSRAM / BSS
CONFIG_SPIRAM_ALLOW_BSS_SEG=y
# NO activar SPIRAM_USE_MALLOC — los emuladores acceden a sus buffers desde
# código cacheado (IRAM) que no puede leer PSRAM, causando LoadStoreError.
# CONFIG_SPIRAM_USE_MALLOC=y   ← DESACTIVADO
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_HZ=1000

# Bluetooth
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_ESP32_WIFI_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_BLE_MAX_CONN=1

# FreeRTOS
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
